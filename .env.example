# Copie para .env (o script de instalação faz isso) e preencha. NUNCA suba o .env para o GitHub.

# --- Já gerados na instância ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# --- Controle de gasto ---
DAILY_BUDGET_USD=3

# --- Shopify (Configurações > Apps > Desenvolver apps; escopos read_products, read_orders, read_inventory) ---
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
SHOPIFY_ADMIN_TOKEN=
STORE_PUBLIC_URL=https://www.florela.com.br

# --- IA ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Telegram (crie o bot no @BotFather; seu id numérico pelo @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Instagram (conta Profissional ligada a uma Página; token com instagram_content_publish) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Higgsfield (só quando tivermos a API HTTP confirmada) ---
HIGGSFIELD_API_KEY=

# --- GitHub (token fine-grained só deste repo: Contents e Pull requests com escrita) ---
GITHUB_TOKEN=
GITHUB_REPO=PedroReisgg/Florela-Bot
GITHUB_BASE_BRANCH=claude/project-thread-58zlgu

# --- HTTPS depois (DuckDNS) ---
N8N_DOMAIN=
# Quando ligar o HTTPS, troque para: N8N_SECURE_COOKIE=true, N8N_HOST=<seu domínio>, WEBHOOK_URL=https://<seu domínio>/
